<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress injected-client warning logs for cache overlay mismatches -->
    <logger name="injected-client" level="ERROR" />

    <!-- Suppress noisy worldhopper ping timeout warnings -->
    <logger name="net.runelite.client.plugins.worldhopper.ping" level="ERROR" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
